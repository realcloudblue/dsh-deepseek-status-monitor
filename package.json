{
  "name": "dsh-deepseek-status-monitor",
  "version": "1.1.0",
  "type": "module",
  "description": "DeepSeek status monitor with account balance, peak/off-peak pricing, privacy mode, and locally estimated session-spend TOP3 for the DSH Web GUI.",
  "license": "MIT",
  "author": "无尽云岚",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realcloudblue/dsh-deepseek-status-monitor.git"
  },
  "homepage": "https://github.com/realcloudblue/dsh-deepseek-status-monitor#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "status-page",
    "monitor",
    "balance",
    "session-spend",
    "usage",
    "privacy",
    "incident",
    "health",
    "web-ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
